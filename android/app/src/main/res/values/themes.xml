<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.YuWhisperAccount" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#00FFFFFF</item>
        <item name="android:navigationBarColor">@color/account_window_background</item>
        <item name="android:windowLightStatusBar">@bool/account_light_system_bars</item>
        <item name="android:windowBackground">@color/account_window_background</item>
    </style>

    <style name="Theme.YuWhisperAccount.Confirm" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>
</resources>
